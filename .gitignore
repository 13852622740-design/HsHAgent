# =========================
# Secrets / local config
# =========================
.env
.env.*
!.env.example

application-dev.properties
**/application-dev.properties
**/application-local.properties
**/application-secret.properties
**/application-private.properties

# Keep example files
!application-dev.example.properties
!**/application-dev.example.properties

# MCP configs may contain local absolute paths, cookies, or tokens.
# Commit sanitized example configs instead.
**/mcpConfig/mcp-servers-config.json
!**/mcpConfig/mcp-servers-config.example.json

# =========================
# Logs
# =========================
*.log
*.log.*
*.gz
logs/
log/
data/log/
**/data/log/
vite-dev.log

# =========================
# Java / Maven
# =========================
target/
**/target/
*.class
*.jar
*.war
*.ear

# Maven wrapper jar is generated/downloaded locally if present.
.mvn/wrapper/maven-wrapper.jar
**/.mvn/wrapper/maven-wrapper.jar

# =========================
# Node / Vite / frontend
# =========================
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
build/
coverage/
*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# IDE / editor
# =========================
.idea/
**/.idea/
.vscode/
**/.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json

*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

